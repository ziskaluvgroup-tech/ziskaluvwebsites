{
  "routes": [
    {
      "src": "/assets/ziska-luv-websites-official-logo.webp",
      "dest": "/assets/ziska-luv-websites-official-logo.webp"
    },
    {
      "src": "/.*",
      "dest": "/maintenance.html",
      "status": 503,
      "headers": {
        "Cache-Control": "no-store",
        "Retry-After": "86400",
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ]
}
